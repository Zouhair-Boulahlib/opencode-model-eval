{"id": "prt_1b390742b001zXz3e93zTHpXAg", "tool": "write", "status": "completed", "input": {"content": "import sys\nimport os\nimport json\n\n\ndef get_todo_file():\n    return os.environ.get(\"TODO_FILE\", \"todo.json\")\n\n\ndef load():\n    path = get_todo_file()\n    if not os.path.exists(path):\n        return {\"max_id\": 0, \"tasks\": []}\n    with open(path, \"r\") as f:\n        return json.load(f)\n\n\ndef save(data):\n    path = get_todo_file()\n    with open(path, \"w\") as f:\n        json.dump(data, f)\n\n\ndef print_usage():\n    sys.stderr.write(\"Usage: todo.py <add|list|done|remove|clear> ...\\n\")\n    sys.exit(2)\n\n\ndef main():\n    args = sys.argv[1:]\n\n    if not args:\n        print_usage()\n\n    command = args[0]\n\n    if command == \"add\":\n        if len(args) < 2:\n            print_usage()\n        text = \" \".join(args[1:])\n        data = load()\n        data[\"max_id\"] += 1\n        data[\"tasks\"].append({\"id\": data[\"max_id\"], \"text\": text, \"done\": False})\n        save(data)\n        print(f\"Added {data['max_id']}: {text}\")\n\n    elif command == \"list\":\n        data = load()\n        if not data[\"tasks\"]:\n            print(\"No tasks\")\n        else:\n            for task in sorted(data[\"tasks\"], key=lambda t: t[\"id\"]):\n                status = \"[x]\" if task[\"done\"] else \"[ ]\"\n                print(f\"{status} {task['id']}: {task['text']}\")\n\n    elif command == \"done\":\n        if len(args) < 2:\n            print_usage()\n        try:\n            task_id = int(args[1])\n        except ValueError:\n            print_usage()\n        data = load()\n        found = False\n        for task in data[\"tasks\"]:\n            if task[\"id\"] == task_id:\n                task[\"done\"] = True\n                found = True\n                break\n        if not found:\n            sys.stderr.write(f\"Error: no task {task_id}\\n\")\n            sys.exit(1)\n        save(data)\n        print(f\"Done {task_id}\")\n\n    elif command == \"remove\":\n        if len(args) < 2:\n            print_usage()\n        try:\n            task_id = int(args[1])\n        except ValueError:\n            print_usage()\n        data = load()\n        found = False\n        for i, task in enumerate(data[\"tasks\"]):\n            if task[\"id\"] == task_id:\n                del data[\"tasks\"][i]\n                found = True\n                break\n        if not found:\n            sys.stderr.write(f\"Error: no task {task_id}\\n\")\n            sys.exit(1)\n        save(data)\n        print(f\"Removed {task_id}\")\n\n    elif command == \"clear\":\n        data = load()\n        done_count = sum(1 for t in data[\"tasks\"] if t[\"done\"])\n        data[\"tasks\"] = [t for t in data[\"tasks\"] if not t[\"done\"]]\n        save(data)\n        print(f\"Cleared {done_count}\")\n\n    else:\n        print_usage()\n\n\nif __name__ == \"__main__\":\n    main()", "filePath": "todo.py"}, "output": "Wrote file successfully.", "error": ""}
